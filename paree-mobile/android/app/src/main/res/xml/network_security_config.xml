<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow ALL traffic for the Sovereign Browser WebView -->
    <!-- This fixes NET_ERR_BLOCKED_BY_RESPONSE for external domains -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
